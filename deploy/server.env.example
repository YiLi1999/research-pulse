# Bare domain name only: no https://, port, or trailing slash.
# Point its DNS A record to the server before starting HTTPS.
SITE_DOMAIN=research.example.com
APP_TIMEZONE=Asia/Shanghai
ARXIV_CATEGORIES=quant-ph,math
ARXIV_MATH_MAX_PAGES=50

# No model API keys belong here. Each visitor supplies their own in the page.
# The HTTPS Compose overlay derives PUBLIC_ORIGIN=https://${SITE_DOMAIN}.
