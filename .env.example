# Local development. Docker Compose overrides HOST to 0.0.0.0.
HOST=127.0.0.1
PORT=3100
APP_TIMEZONE=Asia/Shanghai
# Public deployment only: exact browser origin, e.g. https://papers.example.com.
# Leave empty for localhost. The HTTPS Compose overlay sets this for you.
PUBLIC_ORIGIN=

ARXIV_CATEGORY=quant-ph
ARXIV_CATEGORIES=quant-ph,math
ARXIV_WINDOW_DAYS=7
ARXIV_API_PAGE_SIZE=100
ARXIV_API_MAX_PAGES=5
ARXIV_MATH_MAX_PAGES=50
ARXIV_REQUEST_TIMEOUT_MS=20000
ARXIV_ENABLE_FALLBACK=true
DEFAULT_DIRECTION_LABEL=Quantum Physics

# Web trend analysis requires each visitor's Base URL, API Key, and model.
# Do not put LLM_API_KEY or TREND_API_KEY in the public deployment.
